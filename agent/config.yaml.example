# SMART Sniffer Agent configuration
# Copy this file to config.yaml and edit as needed.

# HTTP listen port (default: 9099)
port: 9099

# Bearer token for API authentication.
# If set, all requests must include "Authorization: Bearer <token>".
# Leave empty or omit to disable auth.
token: ""

# How often to re-scan drives and refresh SMART data (default: 60s).
# Accepts Go duration strings: 30s, 1m, 5m, etc.
scan_interval: 60s

# Enable mDNS/Zeroconf service advertisement (default: true).
# When enabled, the agent advertises itself on the local network so
# Home Assistant can auto-discover it.
# Set to false to disable (or use --no-mdns flag).
mdns: true

# Restrict mDNS advertisement to a specific network interface.
# When set, the agent only advertises on this interface and reports
# its IP in the mDNS TXT record so Home Assistant connects to the
# correct address.
#
# When not set (default), the agent auto-filters known virtual
# interfaces (Docker, ZeroTier, Tailscale, WireGuard, etc.) and
# advertises on all remaining physical interfaces.
#
# Examples: eth0, enp1s0, en0, bond0
# advertise_interface: eth0

# Filesystem monitoring (optional).
# Set during install via the Disk Usage Monitoring picker.
# Each entry monitors one mountpoint. The UUID ensures stable entity
# identity in Home Assistant across reboots and device-path changes.
#
# The "fstype" field drives advanced reporting. For filesystems where the
# statfs syscall misreports usage, the agent shells out to the native tool to
# get correct numbers: btrfs multi-device (which can report a zero total) uses
# btrfs-progs, and ZFS uses "zfs list" so a pool path reports real pool-level
# usage instead of the near-zero figure statfs returns for the parent dataset.
# These corrections are automatic; no extra configuration is required.
#
# filesystems:
#   - path: /
#     uuid: a1b2c3d4-5678-90ab-cdef-1234567890ab
#     device: /dev/sda1
#     fstype: ext4
#   - path: /mnt/data
#     uuid: e5f6a7b8-9012-cdef-3456-7890abcdef12
#     device: rpool/data
#     fstype: zfs

# Host mount prefix for containerized deployments (optional).
# When the agent runs in a container with the host filesystem bind-mounted
# under a prefix (for example "-v /:/host:ro"), set this to that prefix so
# filesystem usage is read from the host instead of the container's own
# rootfs. The paths above stay as the host sees them; the agent prepends the
# prefix only when reading usage. Leave unset when running directly on a host.
# The SMARTHA_MOUNT_PREFIX environment variable overrides this value.
#
# mount_prefix: /host

# Verbose logging (default: false).
# When false, the agent suppresses repeated log lines: a recurring condition
# (a failing drive, a broken mount, a persistent smartctl exit code) is logged
# once, again whenever its detail changes, and otherwise at most once per hour.
# Set to true to log every poll cycle instead, which is useful when diagnosing
# an issue. The --verbose flag also enables this; the flag can turn verbose on
# but does not turn off a "verbose: true" set here.
# verbose: false
